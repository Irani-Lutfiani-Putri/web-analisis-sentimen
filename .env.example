SECRET_KEY=replace-with-long-random-secret

# Laragon MySQL. The setup script reads DB_* to create both databases, then
# prints DATABASE_URL / TEST_DATABASE_URL that match them.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=sentiment_freeport
DB_TEST_NAME=sentiment_freeport_test

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/sentiment_freeport?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/sentiment_freeport_test?charset=utf8mb4

UPLOAD_FOLDER=storage/uploads
MODEL_FOLDER=storage/models
LEXICON_FOLDER=storage/lexicon
MAX_CONTENT_LENGTH=16777216
SESSION_COOKIE_SECURE=false
